---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE + ' | Family, Relationship & Workplace Drama'} description={SITE_DESCRIPTION} />
		<style>
			.intro h1 {
				margin-bottom: 0.25em;
			}
			.intro p {
				font-size: 1.1em;
			}
			.story-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.story-list li {
				padding: 1.25em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.story-list h3 {
				font-size: 1.4em;
				margin: 0 0 0.25em 0;
			}
			.story-list a {
				text-decoration: none;
			}
			.meta {
				color: rgb(var(--gray));
				font-size: 0.85em;
				margin: 0 0 0.5em 0;
			}
			.excerpt {
				margin: 0;
			}
			.more {
				margin-top: 1.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>
					Family feuds, relationship twists, office politics and neighbor wars. We tell every
					story from start to finish, so you never have to hunt for the update.
				</p>
			</section>

			<section>
				<h2>Latest stories</h2>
				{
					posts.length === 0 ? (
						<p>New stories are on the way. Check back soon.</p>
					) : (
						<ul class="story-list">
							{posts.map((post) => (
								<li>
									<a href={'/blog/' + post.id + '/'}>
										<h3>{post.data.title}</h3>
									</a>
									<p class="meta">
										{CATEGORIES[post.data.category]} · <FormattedDate date={post.data.pubDate} />
									</p>
									<p class="excerpt">{post.data.description}</p>
								</li>
							))}
						</ul>
					)
				}
				<p class="more"><a href="/blog">Browse all stories →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
