---
const path = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Home', active: path === '/' },
	{ href: '/blog/', label: 'Stories', active: path.startsWith('/blog') },
	{ href: '/category/scary/', label: 'Scary Stories', active: path.startsWith('/category/scary') },
	{ href: '/about/', label: 'About', active: path.startsWith('/about') },
	{ href: '/contact/', label: 'Contact', active: path.startsWith('/contact') },
];
---

<header>
	<nav>
		<a href="/" class="brand" aria-label="Drama Stories home">
			<img src="/favicon.svg" width="36" height="36" alt="" />
			<span class="brand-text">Drama <span class="brand-accent">Stories</span></span>
		</a>
		<div class="internal-links">
			{
				links.map((l) => (
					<a href={l.href} class:list={[{ active: l.active }]}>
						{l.label}
					</a>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 0;
		border-bottom: none;
		text-decoration: none;
	}
	.brand img {
		border-radius: 8px;
	}
	.brand-text {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 700;
		font-size: 1.15em;
		color: #2b1035;
	}
	.brand-accent {
		color: #e63958;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.internal-links a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	.internal-links a.active {
		font-weight: bolder;
		border-bottom-color: #e63958;
	}
	@media (max-width: 720px) {
		.internal-links a {
			padding: 0.6em 0.4em;
			font-size: 0.85em;
		}
	}
</style>
